[
  {
    "name": "project_load",
    "description": "Compile one SystemVerilog top from explicit ordered source_files. Paths must be absolute and exist; source order and duplicates are preserved. Supply child modules, packages, include_directories and defines explicitly. Missing dependencies remain diagnostics. The top uses standalone parameter defaults; completeness is not verified.",
    "inputSchema": {
      "properties": {
        "top_module": {
          "type": "string"
        },
        "defines": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        },
        "source_files": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1
        },
        "include_directories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "single_unit": {
          "type": "boolean",
          "default": true,
          "description": "Compile ordered sources as one compilation unit, sharing macros and compilation-unit declarations. Set false for a separate compilation unit per file."
        }
      },
      "required": [
        "source_files",
        "top_module"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "project_info",
    "description": "Return build and elaboration information without rebuilding.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "get_diagnostics",
    "description": "Return bounded Slang diagnostics, total_count, truncated and analysis scope. Unknown-module/package scope hints identify possible missing dependencies, never harmless errors. Syntax/type errors remain visible; completeness is not inferred.",
    "inputSchema": {
      "properties": {
        "limit": {
          "default": 100,
          "type": "integer"
        },
        "severity": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "find_symbol",
    "description": "Find semantic declarations by exact name.",
    "inputSchema": {
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "describe_symbol",
    "description": "Describe one semantic symbol by stable id, qualified name, or name.",
    "inputSchema": {
      "properties": {
        "identifier": {
          "type": "string"
        }
      },
      "required": [
        "identifier"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "get_hierarchy",
    "description": "Return the elaborated instance and generate hierarchy. root accepts an exact elaborated instance or generate-block path, or a top name.",
    "inputSchema": {
      "properties": {
        "root": {
          "type": "string"
        },
        "max_depth": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "get_references",
    "description": "Bounded source-level semantic references. kind read or write includes read_write accesses; kind port_connection filters port-binding context. No netlist inference.",
    "inputSchema": {
      "properties": {
        "symbol": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "read_write",
            "declaration",
            "unknown",
            "parameter_reference",
            "port_connection",
            "type_reference",
            "instantiation"
          ]
        },
        "limit": {
          "default": 100,
          "type": "integer"
        }
      },
      "required": [
        "symbol"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "list_symbols",
    "description": "List direct semantic scope members.",
    "inputSchema": {
      "properties": {
        "scope": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "limit": {
          "default": 100,
          "type": "integer"
        }
      },
      "required": [
        "scope"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "list_instances",
    "description": "Filter elaborated instances by type, exact name and path prefix.",
    "inputSchema": {
      "properties": {
        "sv_module": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path_prefix": {
          "type": "string"
        },
        "limit": {
          "default": 100,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "list_instance_facts",
    "description": "Selected effective parameters and resolved port connections for every elaborated instance of one module type. Optional parameter_names and port_names select exact names; limit bounds instances and fact_limit bounds each nested collection.",
    "inputSchema": {
      "properties": {
        "sv_module": {
          "type": "string"
        },
        "parameter_names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "port_names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": 100,
          "type": "integer"
        },
        "fact_limit": {
          "default": 100,
          "type": "integer"
        }
      },
      "required": [
        "sv_module"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "get_state_elements",
    "description": "Signals written in always_ff; no reset or synthesis inference.",
    "inputSchema": {
      "properties": {
        "sv_module": {
          "type": "string"
        },
        "limit": {
          "default": 100,
          "type": "integer"
        }
      },
      "required": [
        "sv_module"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "inspect_module",
    "description": "Module declaration signature and optional elaborated usage sections. Defaults to parameters and ports.",
    "inputSchema": {
      "properties": {
        "sv_module": {
          "type": "string"
        },
        "limit": {
          "default": 100,
          "type": "integer"
        },
        "fields": {
          "description": "Sections to return; omitted returns parameters and ports. Identity is always included.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "parameters",
              "ports",
              "declaration_count",
              "children",
              "procedures",
              "diagnostic_count"
            ]
          },
          "maxItems": 6
        },
        "parameter_names": {
          "description": "Exact names to include, filtered before the section limit.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 500
        },
        "port_names": {
          "description": "Exact names to include, filtered before the section limit.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 500
        }
      },
      "required": [
        "sv_module"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "inspect_instance",
    "description": "Effective instance parameters and resolved source-level port connections, with optional children. Defaults to parameters and connections.",
    "inputSchema": {
      "properties": {
        "instance_path": {
          "type": "string"
        },
        "limit": {
          "default": 100,
          "type": "integer"
        },
        "fields": {
          "description": "Sections to return; omitted returns parameters and connections. Identity is always included.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "parameters",
              "connections",
              "children"
            ]
          },
          "maxItems": 3
        },
        "parameter_names": {
          "description": "Exact names to include, filtered before the section limit.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 500
        },
        "port_names": {
          "description": "Exact names to include, filtered before the section limit.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 500
        }
      },
      "required": [
        "instance_path"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  }
]
